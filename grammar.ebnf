(* @startebnf *)
number = ? 0-9 ?, {? 0-9 ?};

second = "s";

minute = "min", [number, second] | second;

hour = "h", [number, minute] | minute;

day = "d", [number, hour] | hour;

primary = number, [day] | "(", expression, ")";

factor = primary, {("/" | "*"), primary};

term = factor, {("-" | "+"), factor};

expression = term;

(* @endebnf *)