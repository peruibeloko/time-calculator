(* @startebnf *)
number = ? 0-9 ?, {number};

second = number, "s";

minute = number, "min", [second];

hour = number, "h", [minute];

day = number, "d", [hour];

time = day | hour | minute | second;

primary = number | time | "(", expression, ")";

factor = primary, {("/" | "*"), primary};

term = factor, {("-" | "+"), factor};

expression = term;

(* @endebnf *)