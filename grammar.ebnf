number
  = ? 0-9 ?, { number };

day
  = number, "d", [ hour ];

hour
  = number, "h", [ minute ];

minute
  = number, "min", [ minute ];

second
  = number, "s";

time
  = day
  | hour
  | minute
  | second;

primary
  = number
  | time
  | "(", expression, ")";

factor
  = primary, { ( "/"
  | "*" ), primary };

term
  = factor, { ( "-"
  | "+" ), factor };

expression
  = term;